<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".MulaApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mula"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mula">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 响应系统里的 http(s) 链接 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".DownloadActionReceiver"
            android:exported="false" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          GeckoView 子进程服务。GeckoView 按固定类名 bindService 拉起内容/GPU/网络等进程，
          服务必须声明在「已安装的主应用」里（插件 APK 不会被安装，它的清单系统不会读）。
          类本身在插件 dex 里，子进程启动时由 MulaApplication 注入 ClassLoader。
          多声明不会有副作用（类不存在时只是不会被绑定）；缺哪个以 GeckoPluginManager.verifyChildServices() 的报错为准。
          不设 isolatedProcess：插件文件放在 filesDir，isolated 进程读不到。
        -->
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$gpu" android:process=":gpu" android:exported="false" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$socket" android:process=":socket" android:exported="false" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$utility" android:process=":utility" android:exported="false" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$gmplugin" android:process=":gmplugin" android:exported="false" />
