plugins {
    id("com.android.application")
}

val geckoViewVersion = providers.gradleProperty("geckoViewVersion").orElse("157.0.20260910085851")

android {
    namespace = "dev.dash.mula.geckoplugin"
    compileSdk {
        version = release(37) {
            minorApiLevel = 2
        }
    defaultConfig {
        applicationId = "dev.dash.mula.geckoplugin"
        minSdk = 26
        targetSdk = 36
        versionCode = 1
        versionName = geckoViewVersion.get()
    }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
    buildTypes { release { isMinifyEnabled = false } }
    packaging {
        jniLibs { useLegacyPackaging = false }
        resources { excludes += "/META-INF/{AL2.0,LGPL2.1}" }
    }
}

dependencies {
    implementation("org.mozilla.geckoview:geckoview-nightly:${geckoViewVersion.get()}")
}
